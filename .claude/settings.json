{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob",
      "Agent",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(pytest:*)",
      "Bash(alembic current:*)",
      "Bash(alembic history:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Grep(./.env)",
      "Grep(./.env.local)",
      "Grep(./.env.production)",
      "Grep(./.env.development)",
      "Grep(./.env.test)",
      "Grep(./.env.staging)",
      "Grep(./secrets/**)",
      "Grep(./credentials/**)",
      "Glob(./secrets/**)",
      "Glob(./credentials/**)",
      "Bash(env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_bash_command.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
