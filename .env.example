FLASK_APP=wsgi:app
# FLASK_ENV selects the config class in app/config.py (development,
# testing, or production) — an unset value defaults to development, but
# an unrecognized value now raises RuntimeError rather than silently
# falling back. MUST be set to `production` before any non-local
# deployment: development config runs with DEBUG=True, non-secure
# session cookies, and no HSTS, and skips ProductionConfig's fail-fast
# SECRET_KEY/DATABASE_URL checks.
FLASK_ENV=development
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://wfm_app:CHANGEME@localhost:5432/wfm_dev
TEST_DATABASE_URL=postgresql+psycopg://wfm_app:CHANGEME@localhost:5432/wfm_test

# Required in production only (app/config.py's ProductionConfig fails
# fast at boot without these). Shared Flask-Limiter storage — without
# it, per-IP rate limits reset independently per Gunicorn worker.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# SMTP delivery for app.services.notifications — required in production;
# ignored in development (emails are logged instead, MAIL_BACKEND=console)
# and in testing (MAIL_BACKEND=suppress).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM_ADDRESS=

# How many Gunicorn worker processes to run (see gunicorn.conf.py).
WEB_CONCURRENCY=3
